{
    "coc.preferences.currentFunctionSymbolAutoUpdate": true,
    "coc.preferences.rootPatterns": [".ctrlp", ".git", ".hg", ".projections.json"],
    "diagnostic.displayByAle": "true",
    "diagnostic.enable": "true",

    "python.pythonPath":  "~/.vim/pyright_conda.sh",

    "suggest.maxPreviewWidth": "45",
    "suggest.detailMaxLength": "30",
    "suggest.labelMaxLength": "15",
    "suggest.autoTrigger": "always",
    "suggest.noselect": "true",

    "list.source.grep.command": "ag",
    "list.source.grep.args": ["-folder"],
    "list.source.grep.excludePatterns": ["tags"],

    "list.normalMappings": {
    "t": "action:tabe",
    "v": "action:vsplit",
    "s": "action:split",
    "d": "expr:GetDeleteAction"
    },

    "list.insertMappings": {
    "<C-t>": "action:tabe",
    "<C-w>": "command:wincmd k"
    },

    "snippets.ultisnips.pythonPrompt": false,
}
